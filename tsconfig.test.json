{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2020",
    "outDir": "./dist/test",
    "rootDir": "./",
    "noEmit": false,
    "types": [
      "node",
      "mocha"
    ],
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.spec.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}